# AWS Configuration
AWS_REGION=us-east-1

# Optional if using ~/.aws/credentials or IAM role; required if providing explicit credentials:
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# SNS: Topic ARN for security desk notifications
# Example: arn:aws:sns:us-east-1:123456789012:campus-security-gate-alerts
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:campus-security-gate-alerts

# SES: Verified identity (email address or domain) used as sender
# In SES sandbox, both sender and recipient emails must be verified in AWS Console
SES_SENDER_EMAIL=security-office@campus.edu

# Flask Application Secret Key
SECRET_KEY=campus-gate-pass-secret-demo-key
